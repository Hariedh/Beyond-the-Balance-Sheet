# Copy to .env (never commit .env). Everything here is optional:
# rules-only commentary works with none of it.

# --- Option 1: Google Gemini (free tier available) ---------------------------
# Create a key in Google AI Studio (https://aistudio.google.com/). Free-tier limits and the
# models included are shown in your AI Studio account. Model IDs change: check the current list.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- Option 2: local open-source model with Ollama (nothing leaves your machine)
# Install Ollama, then e.g.:  ollama pull llama3.1:8b   (or qwen2.5:7b, mistral, ...)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# --- Option 3: any OpenAI-compatible endpoint (Groq, OpenRouter, LM Studio, vLLM, ...)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=

# --- Option 4: Anthropic Claude -----------------------------------------------
# ANTHROPIC_API_KEY=
# BTB_AI_MODEL=claude-sonnet-5-5

# Override the SQLite database location (default: data/btb.sqlite).
# BTB_DB_PATH=data/btb.sqlite
